# Server local time. CRÍTICO: todo el módulo de ventas reporta días/horas
# en esta zona. Si el backend se despliega a un host UTC sin este env, los
# ingresos del día se desplazan 5 horas y las ventas de la noche caen "al
# día siguiente". El startup falla ruidosamente si no coincide (ver main.ts).
TZ=America/Bogota

DATABASE_URL=postgresql://coffee_user:coffee_password@localhost:5433/coffee_bar
YOUTUBE_API_KEY=AIzaSyBxTs6mL368ifCBfXAdVdkSSz5rqdIOnBQ

# Auth — dev values. ROTATE BEFORE PRODUCTION.
JWT_SECRET=dev-secret-rotate-in-prod-9f8a7c6e5d4b3a2918f7e6d5c4b3a291
JWT_ADMIN_EXPIRES_IN=12h
JWT_SESSION_EXPIRES_IN=6h
# Admin seed — used only by `npx prisma db seed`.
SEED_ADMIN_EMAIL=admin@cafe.local
SEED_ADMIN_PASSWORD=admin123

# Email (Resend). Required for password-reset and security alerts.
RESEND_API_KEY=
EMAIL_FROM=Crown Bar <onboarding@resend.dev>
SECURITY_NOTIFY_EMAIL=caenpes2003@gmail.com
RESET_BASE_URL=http://localhost:3000
